{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stellaria",
  "version": "0.1.0",
  "identifier": "app.stellaria.studio",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "星籁 Stellaria",
        "width": 1360,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#e9e5df",
        "theme": "Dark",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*",
        "img-src": "'self' http://127.0.0.1:* data: blob: asset: http://asset.localhost",
        "media-src": "'self' http://127.0.0.1:* data: blob: asset: http://asset.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self'",
        "worker-src": "'self' blob:"
      },
      "devCsp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*",
        "img-src": "'self' http://127.0.0.1:* data: blob: asset: http://asset.localhost",
        "media-src": "'self' http://127.0.0.1:* data: blob: asset: http://asset.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval'",
        "worker-src": "'self' blob:"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "publisher": "Stellaria",
    "copyright": "Stellaria contributors. DDSP-SVC engine under the MIT license.",
    "category": "Music",
    "shortDescription": "Singing voice conversion studio",
    "longDescription": "星籁 Stellaria — prepare material, train and create with DDSP-SVC, without a terminal.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/"
    ]
  }
}
